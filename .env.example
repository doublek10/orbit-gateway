# Private-network URL of the Orbit Kernel. Never point this at a public
# endpoint - the Gateway is the only thing allowed to reach the Kernel.
KERNEL_URL=http://localhost:8000

# Must match the Kernel's GATEWAY_SHARED_SECRET exactly.
GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret

NODE_ENV=development

# --- WhatsApp Channel (Meta Cloud API) ---
# One-time value you choose and enter into the Meta App dashboard's
# webhook subscription form; the Gateway echoes it back during the
# verification handshake.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-verify-token
# Meta App Secret - used to verify X-Hub-Signature-256 on every inbound
# webhook call. Required in production; without it the webhook route
# refuses all inbound messages.
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
# A permanent system-user access token with whatsapp_business_messaging
# permission, used to send replies via the Graph API.
WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-system-user-token
# The Cloud API "Phone number ID" (from the Meta App's WhatsApp
# product page) - not the WhatsApp number itself.
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v21.0
# The Meta-approved Authentication template used to send one-time
# verification codes. Create this once under WhatsApp Manager > Message
# Templates (category: Authentication) and wait for Meta's approval -
# usually fast, but required before "connect a number" works.
WHATSAPP_AUTH_TEMPLATE_NAME=orbit_verification
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US
